# Real session authentication is the default. Preview sample data with ?demo=1.
VITE_DEMO_MODE=false
# Same regional backend for account, workspace, and QC routes. No shared API key.
KANOOK_BACKEND_URL=https://kanook.oru-el.com
# For local integration: run the regional API with loopback cookies on port 8780.
# KANOOK_BACKEND_URL=http://127.0.0.1:8780
# When packaging for the backend's /app mount:
# VITE_BASE_PATH=/app/
