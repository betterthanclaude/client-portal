diff --git a/oruel/service/portal_routes.py b/oruel/service/portal_routes.py
new file mode 100644
index 0000000..f479d3f
--- /dev/null
+++ b/oruel/service/portal_routes.py
@@ -0,0 +1,171 @@
+"""Authenticated project settings, QC dispatch, and durable grievance receipts."""
+import hashlib
+import json
+import uuid
+from typing import Annotated, Literal
+
+from fastapi import Depends, HTTPException
+from pydantic import Field, field_validator
+
+from .api import IdempotencyKey, Message
+from .production_routes import RegionalQcSubmission, submit_dataset_with_budget
+from .workspace_routes import _member, _rows, _files
+
+Weight = Annotated[float, Field(ge=0, le=100)]
+
+
+class Components(Message):
+    visual_similarity: Weight | None = None
+    label_balance: Weight | None = None
+
+
+class VisualWeights(Message):
+    context: Weight | None = None
+    temporal: Weight | None = None
+    layout: Weight | None = None
+    family: Weight | None = None
+    scene: Weight | None = None
+
+
+class LabelTarget(Message):
+    label: str = Field(min_length=1, max_length=100)
+    target: Weight
+
+
+class Requirements(Message):
+    mode: Literal['structured', 'notes']
+    component_weights: Components
+    visual_similarity: VisualWeights
+    label_balance: list[LabelTarget] = Field(max_length=50)
+    notes: str = Field(max_length=10000)
+
+    @field_validator('label_balance')
+    @classmethod
+    def total(cls, value):
+        if sum(item.target for item in value) > 100.000001:
+            raise ValueError('label targets must total at most 100')
+        return value
+
+
+class Configuration(Message):
+    target_score: Weight | None = None
+    selected_file_ids: list[str] | None = Field(default=None, max_length=10000)
+
+
+class ProjectChange(Message):
+    status: Literal['ongoing', 'completed'] | None = None
+    requirements: Requirements | None = None
+    configuration: Configuration | None = None
+
+
+class GrievanceBody(Message):
+    category: Literal['technical', 'billing', 'data', 'access', 'other']
+    subject: str = Field(min_length=3, max_length=160)
+    description: str = Field(min_length=20, max_length=10000)
+    project_id: str | None = Field(default=None, max_length=64)
+
+    @field_validator('subject', 'description')
+    @classmethod
+    def nonblank(cls, value):
+        if not value.strip():
+            raise ValueError('must not be blank')
+        return value.strip()
+
+
+def project_metadata(store, principal, project_id):
+    rows = _rows(store, 'SELECT settings,updated FROM control_project_settings WHERE org=? AND project_id=?',
+                 (principal.organization, project_id))
+    settings = json.loads(rows[0]['settings']) if rows else {}
+    return dict(status='ongoing', requirements=None,
+                configuration={'target_score': None, 'selected_file_ids': None}
+                ) | settings | {'updated': rows[0]['updated'] if rows else None}
+
+
+def register_portal(app, store, customer):
+    @app.patch('/workspace/projects/{project_id}', tags=['Workspace'])
+    def update_project(project_id: str, body: ProjectChange, principal=Depends(customer)):
+        with store.organization_transaction(principal.organization) as db:
+            _member(store, principal, project_id, write=True)
+            if body.configuration and body.configuration.selected_file_ids is not None:
+                allowed = {item['id'] for item in _files(store, principal, project_id)}
+                if not set(body.configuration.selected_file_ids) <= allowed:
+                    raise HTTPException(422, 'Selection contains files outside this project.')
+            settings = project_metadata(store, principal, project_id)
+            settings.pop('updated', None)
+            settings.update({key: value for key, value in body.model_dump(exclude_unset=True).items()
+                             if value is not None})
+            db.execute('''INSERT INTO control_project_settings VALUES (?,?,?,?)
+                ON CONFLICT(org,project_id) DO UPDATE SET settings=excluded.settings,updated=excluded.updated''',
+                (principal.organization, project_id, json.dumps(settings), store.clock()))
+        return {'id': project_id, **project_metadata(store, principal, project_id)}
+
+    @app.get('/workspace/projects/{project_id}/api-keys', tags=['Workspace'])
+    def project_keys(project_id: str, principal=Depends(customer)):
+        _member(store, principal, project_id, write=True)
+        return {'items': _rows(store, '''SELECT k.id,k.created,k.expires,k.revoked,
+            COALESCE(n.name,'Upload key') AS name, NULL AS last_used
+            FROM control_project_upload_keys k LEFT JOIN control_project_key_labels n
+            ON n.org=k.org AND n.key_id=k.id WHERE k.org=? AND k.project_id=? ORDER BY k.created DESC''',
+            (principal.organization, project_id))}
+
+    @app.delete('/workspace/projects/{project_id}/api-keys/{key_id}', tags=['Workspace'])
+    def revoke_project_key(project_id: str, key_id: str, principal=Depends(customer)):
+        _member(store, principal, project_id, write=True)
+        with store._connect(write=True, organization=principal.organization) as db:
+            db.execute('UPDATE control_project_upload_keys SET revoked=1 WHERE org=? AND project_id=? AND id=?',
+                       (principal.organization, project_id, key_id))
+        return {'revoked': True}
+
+    register_project_runs(app, store, customer)
+    register_grievances(app, store, customer)
+
+
+def register_project_runs(app, store, customer):
+    @app.post('/workspace/projects/{project_id}/runs', status_code=202, tags=['Workspace'])
+    def dispatch(project_id: str, body: RegionalQcSubmission, key: IdempotencyKey, principal=Depends(customer)):
+        with store.organization_transaction(principal.organization) as db:
+            _member(store, principal, project_id, write=True)
+            store.authorize(principal, 'jobs:write')
+            job = submit_dataset_with_budget(store, principal, body, key, 'portal-qc:'+project_id)
+            db.execute('''INSERT INTO control_project_runs VALUES (?,?,?,?)
+                ON CONFLICT(org,project_id,job_id) DO NOTHING''',
+                (principal.organization, project_id, job['id'], store.clock()))
+        return job
+
+    @app.get('/workspace/projects/{project_id}/runs', tags=['Workspace'])
+    def runs(project_id: str, principal=Depends(customer)):
+        _member(store, principal, project_id)
+        rows = _rows(store, '''SELECT job_id FROM control_project_runs WHERE org=? AND project_id=?
+            ORDER BY created DESC LIMIT 50''', (principal.organization, project_id))
+        return {'items': [store.dataset_job(principal, row['job_id']) for row in rows]}
+
+
+def grievance_receipt(row):
+    return {key: row[key] for key in ('id', 'subject', 'category', 'status', 'created')}
+
+
+def register_grievances(app, store, customer):
+    @app.get('/workspace/grievances', tags=['Support'])
+    def grievances(principal=Depends(customer)):
+        account = store.account(principal)
+        rows = _rows(store, '''SELECT * FROM control_grievances WHERE org=? AND member_id=?
+            ORDER BY created DESC LIMIT 100''', (principal.organization, account['member_id']))
+        return {'items': [grievance_receipt(row) for row in rows]}
+
+    @app.post('/workspace/grievances', status_code=201, tags=['Support'])
+    def submit(body: GrievanceBody, key: IdempotencyKey, principal=Depends(customer)):
+        account = store.account(principal)
+        if body.project_id:
+            _member(store, principal, body.project_id)
+        digest = hashlib.sha256(body.model_dump_json().encode()).hexdigest()
+        with store.organization_transaction(principal.organization) as db:
+            db.execute('''INSERT INTO control_grievances VALUES (?,?,?,?,?,?,?,'open',?,?,?)
+                ON CONFLICT(org,member_id,request_key) DO NOTHING''',
+                (principal.organization, uuid.uuid4().hex, account['member_id'], body.project_id,
+                 body.subject, body.category, body.description, store.clock(), key, digest))
+            row = db.execute('''SELECT * FROM control_grievances
+                WHERE org=? AND member_id=? AND request_key=?''',
+                (principal.organization, account['member_id'], key)).fetchone()
+            if row['payload_hash'] != digest:
+                raise HTTPException(409, 'This request key was already used for a different grievance.')
+        return grievance_receipt(row)
diff --git a/oruel/service/portal_schema.py b/oruel/service/portal_schema.py
new file mode 100644
index 0000000..fb51607
--- /dev/null
+++ b/oruel/service/portal_schema.py
@@ -0,0 +1,26 @@
+"""Additive metadata for the customer portal; compatible with migration 15."""
+SCHEMA = """
+CREATE TABLE IF NOT EXISTS control_project_settings (
+    org TEXT NOT NULL, project_id TEXT NOT NULL, settings TEXT NOT NULL,
+    updated DOUBLE PRECISION NOT NULL, PRIMARY KEY (org, project_id),
+    FOREIGN KEY (org, project_id) REFERENCES control_projects(org, id)
+);
+CREATE TABLE IF NOT EXISTS control_project_key_labels (
+    org TEXT NOT NULL, key_id TEXT NOT NULL, name TEXT NOT NULL,
+    PRIMARY KEY (org, key_id),
+    FOREIGN KEY (org, key_id) REFERENCES control_project_upload_keys(org, id)
+);
+CREATE TABLE IF NOT EXISTS control_grievances (
+    org TEXT NOT NULL, id TEXT NOT NULL, member_id TEXT NOT NULL, project_id TEXT,
+    subject TEXT NOT NULL, category TEXT NOT NULL, description TEXT NOT NULL,
+    status TEXT NOT NULL DEFAULT 'open', created DOUBLE PRECISION NOT NULL,
+    request_key TEXT NOT NULL, payload_hash TEXT NOT NULL,
+    PRIMARY KEY (org, id), UNIQUE (org, member_id, request_key),
+    FOREIGN KEY (member_id) REFERENCES control_members(id)
+);
+CREATE TABLE IF NOT EXISTS control_project_runs (
+    org TEXT NOT NULL, project_id TEXT NOT NULL, job_id TEXT NOT NULL,
+    created DOUBLE PRECISION NOT NULL, PRIMARY KEY (org, project_id, job_id),
+    FOREIGN KEY (org, project_id) REFERENCES control_projects(org, id)
+);
+"""
