# MVP sample data is enabled by default. Set false to use the real APIs.
VITE_DEMO_MODE=true
# Copy to .env.local. Server-only settings; never use VITE_ for credentials.
KANOOK_QC_API_URL=https://kanook.oru-el.com
KANOOK_QC_TOKEN_FILE=D:/kanook/.local/qc.key
KANOOK_INTAKE_URL=http://127.0.0.1:8782
# Alternative local QC configuration:
# KANOOK_QC_CLIENT_CONFIG=D:/DATA-INGEST/webapp/client.json
# Intake settings are process environment variables; see server/README.md.
